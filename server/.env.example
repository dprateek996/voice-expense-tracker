# Copy to .env and fill values
# PostgreSQL example
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voice_expense_db?schema=public"

# Optional SQLite quick dev fallback:
# DATABASE_URL="file:./dev.db"

ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
CLIENT_ORIGIN=http://localhost:5173
PORT=5001
NODE_ENV=development

# Google Gemini API (if used)
GEMINI_API_KEY="your-gemini-api-key-here"

# Sarvam AI (primary provider)
SARVAM_API_KEY="your-sarvam-api-key-here"
SARVAM_BASE_URL="https://api.sarvam.ai"
SARVAM_CHAT_MODEL="sarvam-m"
SARVAM_STT_MODEL="saarika:v2.5"
SARVAM_STT_LANGUAGE_CODE="unknown"
